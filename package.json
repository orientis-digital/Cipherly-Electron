{
  "name": "cipherly",
  "private": true,
  "version": "0.0.1",
  "description": "Cipherly Zero-Trust Encryption Suite",
  "author": "Orientis Digital <orientisdigital.official@gmail.com>",
  "homepage": "https://orientisdigital.com/cipherly",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && tsc -p tsconfig.electron.json --noEmit && vite build",
    "package": "npm run build && electron-builder",
    "preview": "vite preview",
    "electron:start": "npx electron ."
  },
  "build": {
    "appId": "com.orientisdigital.cipherly",
    "productName": "Cipherly",
    "icon": "public/icon.png",
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "public/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "tar.gz"
      ],
      "category": "Utility"
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ]
    }
  },
  "dependencies": {
    "lucide-react": "^0.344.0",
    "qrcode": "^1.5.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.24",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.2.61",
    "@types/react-dom": "^18.2.19",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.18",
    "electron": "^29.1.0",
    "electron-builder": "^26.15.3",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "vite": "^5.1.4",
    "vite-plugin-electron": "^0.28.0",
    "vite-plugin-electron-renderer": "^0.14.5"
  }
}
